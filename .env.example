POSTGRES_DB=qlkh_db
POSTGRES_USER=qlkh_user
POSTGRES_PASSWORD=qlkh_password

# Trong Docker, hostname database phải là tên service "postgres".
DATABASE_URL=postgresql+psycopg://qlkh_user:qlkh_password@postgres:5432/qlkh_db

APP_NAME=QUANLYKHACHHANG
# Truy cập cùng máy và từ mạng LAN nội bộ.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://10.8.0.119,http://c360.agribank.com.vn
IMPORT_WORKER_COUNT=1
IMPORT_CHUNK_SIZE=20000
DELETE_UPLOAD_AFTER_SUCCESS=true
PROCESSING_WORK_MEM=256MB
REDIS_URL=redis://redis:6379/0
ANALYSIS_CACHE_TTL=900
ANALYSIS_CACHE_MAX_BYTES=20000000
# Bắt buộc tạo giá trị riêng trên từng máy chủ, tối thiểu 32 ký tự.
# Chạy: .\generate-auth-secret.ps1 -EnvFile .env
AUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_BEFORE_STARTING
ACCESS_TOKEN_EXPIRE_MINUTES=240
SESSION_IDLE_MINUTES=30

# Chỉ bật sau khi Caddy trên Windows đã nhận cổng 80 và frontend Docker chỉ
# lắng nghe 127.0.0.1:8080. Giá trị "frontend" là tên service trong Docker.
TRUSTED_PROXY_HOSTNAME=
# FRONTEND_BIND_ADDR=127.0.0.1
# FRONTEND_HOST_PORT=8080
# BACKEND_BIND_ADDR=127.0.0.1

# Chỉ dùng bởi docker-compose.prod.yml trên máy chủ Windows.
APP_DATA_DIR=D:/Apps/QUANLYKHACHHANG/data
IMAGE_TAG=latest
